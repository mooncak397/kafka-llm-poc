 "panels": [
  {
   "id": 1,
   "type": "table",
   "title": "LLM load per run (u1, u10, u20)",
   "description": "Cumulative histograms per run, read at the end of the time range (use a range that ends after the last run). Prometheus histogram buckets are coarse (\u20265, 10, 20, 30 s), so histogram_quantile interpolates inside one bucket: at 10 and 20 users p50 is within about 15 % and p95 about 30 % of the client values in evidence/results.md Table 1 (too high, bucket (5,10] and (10,20]); at 1 user within about 5 %. u10 and u20 hold both runs of the level. Label u1 also holds 19 requests from manual tests before S24 (19 of 293), so u1 is slightly mixed. The JSON files and Table 1 are clean.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le, run) (llm_ttft_seconds_bucket{run=~\"$run\"}))",
     "instant": true,
     "refId": "A",
     "format": "table",
     "legendFormat": "{{run}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, run) (llm_ttft_seconds_bucket{run=~\"$run\"}))",
     "instant": true,
     "refId": "B",
     "format": "table",
     "legendFormat": "{{run}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le, run) (llm_queue_wait_derived_seconds_bucket{run=~\"$run\"}))",
     "instant": true,
     "refId": "C",
     "format": "table",
     "legendFormat": "{{run}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, run) (llm_queue_wait_derived_seconds_bucket{run=~\"$run\"}))",
     "instant": true,
     "refId": "D",
     "format": "table",
     "legendFormat": "{{run}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le, run) (llm_tokens_per_second_bucket{run=~\"$run\"}))",
     "instant": true,
     "refId": "E",
     "format": "table",
     "legendFormat": "{{run}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum by (run) (llm_requests_total{run=~\"$run\",status!=\"200\"}) or sum by (run) (llm_requests_total{run=~\"$run\"}) * 0) / sum by (run) (llm_requests_total{run=~\"$run\"})",
     "instant": true,
     "refId": "F",
     "format": "table",
     "legendFormat": "{{run}}"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (run) (llm_requests_total{run=~\"$run\"})",
     "instant": true,
     "refId": "G",
     "format": "table",
     "legendFormat": "{{run}}"
    }
   ],
   "transformations": [
